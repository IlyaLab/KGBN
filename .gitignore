# Ignore Python bytecode
*.pyc
__pycache__/
src/__pycache__/
*.egg-info/
.pytest_cache/
.coverage
build/
dist/
docs/build/

# Ignore files in the .DS_Store file
.DS_Store

# ignore root-level generated/static library folder
/lib/

# ignore old local-only data folders
/data/
/input_files/
/ref/

# ignore old simulation folders
/pancreatic_cancer_simulation/**
/AML_simulation/**
/VEN-HMA/

# keep manuscript reproduction inputs lightweight by default
manuscript_reproduction/inputs/*
!manuscript_reproduction/inputs/.gitkeep
manuscript_reproduction/outputs/*
!manuscript_reproduction/outputs/.gitkeep
